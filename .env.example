# Cloudinary Configuration (for image upload script only)
# Get these from your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Note: The cloud name is also hardcoded in src/utils/cloudinary.ts
# for client-side URL generation (no secret needed for public URLs)

# Search Console (optional): content of the google-site-verification meta tag, if the property is
# verified with the HTML tag method. Not needed when the property is verified by DNS or Google Analytics.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Likes of the visuals (app/api/likes/route.ts): Upstash Redis through its REST API.
# Without them, development uses a memory store and production shows no like button at all.
# Vercel injects KV_REST_API_URL and KV_REST_API_TOKEN when the Upstash / KV integration is connected;
# the route accepts both pairs of names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
